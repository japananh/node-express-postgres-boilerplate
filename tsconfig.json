{
	"compilerOptions": {
		"target": "ES2024",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2024"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"noEmit": true,
		"types": ["node", "jest"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
