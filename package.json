{
  "name": "nodejs-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/docs && cp src/docs/*.yml dist/docs/",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --check \"**/*.{js,ts}\"",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:db:up": "docker compose up -d --wait db-test",
    "test:db:down": "docker compose down -v",
    "version": "update-changelog && git add CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japananh/node-express-postgres-boilerplate.git"
  },
  "keywords": [
    "node",
    "node.js",
    "boilerplate",
    "rest",
    "api",
    "express",
    "postgres",
    "sequelize",
    "joi",
    "eslint",
    "prettier",
    "es9"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/japananh/node-express-postgres-boilerplate/issues"
  },
  "homepage": "https://github.com/japananh/node-express-postgres-boilerplate#readme",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "accesscontrol": "^2.2.1",
    "bcrypt": "^5.0.0",
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^5.2.3",
    "helmet": "^4.4.1",
    "http-status": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.4.17",
    "pg": "^8.5.1",
    "pg-hstore": "^2.3.3",
    "sequelize": "^6.37",
    "swagger-jsdoc": "^6.0.2",
    "swagger-ui-express": "^4.1.6",
    "winston": "^3.3.3",
    "xss-clean": "^0.1.1",
    "yesql": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "4",
    "@types/express-rate-limit": "5",
    "@types/hapi__joi": "^17.1.15",
    "@types/jest": "29",
    "@types/jsonwebtoken": "^9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26",
    "@types/nodemailer": "^6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8.57",
    "eslint-config-airbnb-base": "^15",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-import": "^2.31",
    "eslint-plugin-prettier": "^3.3.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "sequelize-cli": "^6.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "update-changelog": "^1.0.2"
